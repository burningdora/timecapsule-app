# Подключение к RDS PostgreSQL
DB_HOST=db.timecapsule.internal
DB_PORT=5432
DB_NAME=timecapsule
DB_USER=timecapsule
DB_PASSWORD=change-me
# require | no-verify (no-verify = TLS без проверки сертификата)
PGSSLMODE=no-verify

# HTTP
PORT=3000

# Сессии (DynamoDB)
SESSIONS_TABLE=timecapsule-dev-sessions
SESSION_SECRET=change-me

# Фоновая отправка почты: inline (медленно, для замера "до") | sns
MAIL_MODE=sns
MAIL_DELAY_SECONDS=5
EVENTS_TOPIC_ARN=arn:aws:sns:eu-central-1:111122223333:timecapsule-dev-events
AWS_REGION=eu-central-1
